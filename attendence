<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>804 午休出席紀錄</title><style>
*{box-sizing:border-box}body{margin:0;background:#edf2f7;color:#18334f;font-family:'Microsoft JhengHei',sans-serif}#app{height:100dvh;display:grid;grid-template-rows:9fr 21fr 47fr 15fr 8fr;gap:1vh;padding:1.4vh 1.4vw;font-size:clamp(12px,2.1vh,30px)}header,footer{display:flex;align-items:center;justify-content:space-between;gap:1vw}header{background:#18334f;color:white;border-radius:12px;padding:0 1.5vw}h1{font-size:1.65em;margin:0}button,input,select{font:inherit;color:inherit;border:1px solid #c4d0df;border-radius:8px;background:white;padding:.35em .55em;min-width:0}button,select{cursor:pointer}button{font-weight:bold}button:hover{filter:brightness(.94)}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1vw}.stat{display:flex;align-items:center;justify-content:center;flex-direction:column;border-radius:12px;background:#dbeafe;color:#1e40af;font-weight:bold}.stat:nth-child(2){background:#dcfce7;color:#166534}.stat:nth-child(3){background:#fee2e2;color:#991b1b}.stat strong{font-size:clamp(30px,9vh,140px);line-height:1.05}.main{display:grid;grid-template-columns:1fr 1fr;gap:1vw;min-height:0}.column{display:grid;grid-template-rows:repeat(6,minmax(0,1fr));gap:.6vh;min-width:0}.entry{background:white;border-radius:9px;display:grid;grid-template-columns:5.1em 5.8em minmax(0,1fr) 2.5em;align-items:center;gap:.4em;padding:.35em .55em;min-height:0}.entry label{font-weight:bold;white-space:nowrap}.entry select{width:100%;font-size:.9em}.chips{display:flex;flex-wrap:wrap;align-content:center;gap:2px;min-width:0}.chip{background:#fee2e2;color:#991b1b;border:0;padding:.12em .3em;font-size:.85em}.count{text-align:right;white-space:nowrap;font-weight:bold}.other{display:flex;align-items:center;gap:.5em;background:white;padding:.35em .55em;border-radius:9px}.other input{flex:1;width:0}.seats{display:grid;grid-template-columns:repeat(14,1fr);grid-template-rows:repeat(2,1fr);gap:.5vh .4vw;min-height:0}.seat{display:flex;align-items:center;justify-content:center;background:#dcfce7;color:#166534;border:0;font-size:1.25em;font-weight:bold;padding:0}.seat.out{background:#fee2e2;color:#991b1b}footer{font-size:.85em}footer button{background:#18334f;color:white;border:0}#status{flex:1}dialog{border:0;border-radius:14px;padding:1.5em;max-width:90vw;color:#18334f}dialog::backdrop{background:#0006}#returnList{display:flex;flex-wrap:wrap;gap:8px;max-width:70vw;margin:1em 0}.dense .chip{font-size:.65em;padding:0 .15em}.dense{gap:1px}@media(max-aspect-ratio: 5/4){#app{height:auto;min-height:100dvh;grid-template-rows:auto auto auto auto auto}.main{grid-template-columns:1fr}.entry{min-height:48px}.stats{min-height:100px}.seats{grid-template-columns:repeat(7,1fr);grid-template-rows:repeat(4,42px)}header,footer{flex-wrap:wrap}h1{font-size:1.3em}}
</style></head><body><main id="app"><header><h1>804 班級午休出席紀錄</h1><div><input type="date" id="date" aria-label="紀錄日期"> <span id="weekday"></span></div></header><section class="stats"><div class="stat">應到人數<strong>28</strong></div><div class="stat">實到人數<strong id="present">28</strong></div><div class="stat">未在教室<strong id="absent">0</strong></div></section><section class="main"><div class="column" id="left"></div><div class="column" id="right"></div></section><section class="seats" id="seats" aria-label="全班出席一覽"></section><footer><span id="status" role="status">綠色：在教室　紅色：未在教室</span><button id="today">今日</button><button id="clear">清空登記</button><button id="copy">複製紀錄</button><button id="full">全螢幕</button></footer></main><dialog id="returns"><strong id="returnTitle"></strong><div id="returnList"></div><button id="closeDialog">關閉</button></dialog><script>
const cats=['事假','病假','公假','喪假','公差勤務','社團活動','導師室','輔導室','教務處','學務處','其他'];const nums=Array.from({length:28},(_,i)=>i+1);const $=id=>document.getElementById(id);const key='804-lunch-attendance-v1:';const fresh=()=>({groups:cats.map(()=>[]),note:''});let data=fresh(),day='';const today=()=>{const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`};const pad=n=>String(n).padStart(2,'0');function load(d){day=d||today();$('date').value=day;try{const raw=JSON.parse(localStorage.getItem(key+day));data=fresh();if(raw&&Array.isArray(raw.groups)){const used=new Set();data.groups=cats.map((_,i)=>(Array.isArray(raw.groups[i])?raw.groups[i]:[]).filter(n=>nums.includes(n)&&!used.has(n)&&(used.add(n),true)));data.note=typeof raw.note==='string'?raw.note:''}}catch(e){data=fresh();$('status').textContent='無法讀取本機紀錄'}$('weekday').textContent='星期'+['日','一','二','三','四','五','六'][new Date(day+'T12:00:00').getDay()];render()}
function save(){try{localStorage.setItem(key+day,JSON.stringify(data));$('status').textContent='已儲存｜綠：在教室　紅：未在教室'}catch(e){$('status').textContent='本機儲存失敗，請複製紀錄備份'}}function change(){save();render()}function remove(i,n){data.groups[i]=data.groups[i].filter(x=>x!==n);change()}function render(){const out=data.groups.flat();$('present').textContent=28-out.length;$('absent').textContent=out.length; $('left').replaceChildren();$('right').replaceChildren();cats.forEach((c,i)=>{const row=document.createElement('div');row.className='entry';const label=document.createElement('label');label.textContent=c;label.htmlFor='select'+i;const sel=document.createElement('select');sel.id='select'+i;sel.add(new Option('選座號',''));nums.filter(n=>!out.includes(n)).forEach(n=>sel.add(new Option(pad(n)+' 號',n)));sel.disabled=out.length===28;sel.onchange=()=>{const n=Number(sel.value);if(nums.includes(n)&&!data.groups.flat().includes(n)){data.groups[i].push(n);data.groups[i].sort((a,b)=>a-b);change()}};const chips=document.createElement('div');chips.className='chips'+(data.groups[i].length>8?' dense':'');if(data.groups[i].length>10){const b=document.createElement('button');b.className='chip';b.textContent='查看 '+data.groups[i].length+' 人';b.onclick=()=>openReturns(i);chips.append(b)}else data.groups[i].forEach(n=>{const b=document.createElement('button');b.className='chip';b.textContent=pad(n)+' ×';b.title='取消登記 '+n+' 號';b.onclick=()=>remove(i,n);chips.append(b)});const count=document.createElement('span');count.className='count';count.textContent=data.groups[i].length+' 人';row.append(label,sel,chips,count);$(i<6?'left':'right').append(row)});const other=document.createElement('div');other.className='other';const l=document.createElement('label');l.textContent='其他原因';l.htmlFor='note';const input=document.createElement('input');input.id='note';input.placeholder='自行填寫去向';input.value=data.note;input.oninput=()=>{data.note=input.value;save()};other.append(l,input);$('right').append(other);$('seats').replaceChildren();nums.forEach(n=>{const i=data.groups.findIndex(g=>g.includes(n));const b=document.createElement('button');b.className='seat'+(i>=0?' out':'');b.textContent=pad(n);b.title=i>=0?cats[i]+'：點擊取消登記':'在教室';b.setAttribute('aria-label',n+'號 '+b.title);if(i>=0)b.onclick=()=>{if(confirm(n+' 號已返回教室？'))remove(i,n)};$('seats').append(b)})}
function openReturns(i){$('returnTitle').textContent=cats[i]+'｜點選座號取消登記';$('returnList').replaceChildren();data.groups[i].forEach(n=>{const b=document.createElement('button');b.textContent=pad(n)+' ×';b.onclick=()=>{remove(i,n);if(data.groups[i].length)openReturns(i);else $('returns').close()};$('returnList').append(b)});if(!$('returns').open)$('returns').showModal()}
$('closeDialog').onclick=()=>$('returns').close();$('date').onchange=()=>load($('date').value);$('today').onclick=()=>load(today());$('clear').onclick=()=>{if(confirm('確定清空 '+day+' 的全部登記？')){data=fresh();change()}};$('copy').onclick=async()=>{const t=[day+' 804 午休出席紀錄','應到：28 人','實到：'+(28-data.groups.flat().length)+' 人','未在教室：'+data.groups.flat().length+' 人',...cats.map((c,i)=>c+'：'+(data.groups[i].map(pad).join('、')||'無')),'其他原因：'+(data.note||'無')].join('\n');try{await navigator.clipboard.writeText(t);$('status').textContent='已複製紀錄'}catch(e){prompt('請手動複製紀錄',t)}};$('full').onclick=async()=>{try{if(document.fullscreenElement)await document.exitFullscreen();else await document.documentElement.requestFullscreen()}catch(e){$('status').textContent='此瀏覽器不支援全螢幕，請使用瀏覽器全螢幕功能'}};document.addEventListener('fullscreenchange',()=>$('full').textContent=document.fullscreenElement?'退出全螢幕':'全螢幕');load(today());let lastToday=today();setInterval(()=>{const now=today();if(now!==lastToday){if(day===lastToday)load(now);lastToday=now}},15000);
</script></body></html>
